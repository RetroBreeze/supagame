{
  "name": "supabase-game-services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "test": "vitest run",
    "db:start": "supabase db start --workdir tests/fixtures/local --network-id supagame-schema-tests-local",
    "db:stage": "node tests/db/stage-migrations.ts",
    "db:migrate": "pnpm db:stage && supabase migration up --workdir tests/fixtures/local",
    "test:db": "supabase test db --workdir tests/fixtures/local --network-id supagame-schema-tests-local tests/db/schema.test.sql tests/db/players.test.sql tests/db/submission.test.sql tests/db/rankings.test.sql tests/db/rankings-plans.test.sql tests/db/live.test.sql tests/db/achievements.test.sql tests/db/cloud-saves.test.sql tests/db/cloud-saves-binary.test.sql tests/db/cloud-saves-rate.test.sql tests/db/cloud-saves-recovery.test.sql && pnpm test:db:concurrency",
    "test:cli:db": "node --test tests/db/leaderboard-migrations.test.ts tests/db/maintenance.test.ts",
    "test:db:concurrency": "node --test tests/db/players-concurrency.test.ts tests/db/submission-concurrency.test.ts tests/db/achievements-concurrency.test.ts tests/db/cloud-saves-concurrency.test.ts",
    "db:stop": "supabase stop --workdir tests/fixtures/local --network-id supagame-schema-tests-local",
    "typecheck": "tsc --noEmit && pnpm -r typecheck && pnpm check:edge",
    "lint": "eslint . --max-warnings=0 && pnpm lint:edge",
    "build": "pnpm -r build",
    "contracts:generate": "openapi-typescript packages/contracts/openapi.yaml -o packages/contracts/src/generated.ts",
    "contracts:check": "openapi-typescript packages/contracts/openapi.yaml -o packages/contracts/src/generated.ts --check && pnpm --filter @supagame/sdk-ts validators:check",
    "api:start": "node tests/api/start-local.ts",
    "test:edge": "deno test --frozen --allow-env --allow-read=packages/contracts/openapi.yaml tests/api/http.test.ts",
    "test:edge:integration": "deno test --frozen --allow-env --allow-read=packages/contracts/openapi.yaml --allow-net=127.0.0.1:55431 --allow-run=./node_modules/.bin/supabase,docker tests/api/http.integration.test.ts",
    "check:edge": "deno check --frozen modules/leaderboards/functions/supagame/index.ts tests/api/http.test.ts tests/api/http.integration.test.ts",
    "lint:edge": "deno lint modules/leaderboards/functions/supagame tests/api/http*.ts && deno fmt --check deno.json modules/leaderboards/functions/supagame tests/api/http*.ts",
    "test:sdk:integration": "vitest run --config tests/sdk/vitest.integration.config.ts",
    "test:e2e": "node --test tests/e2e/install-and-play.test.ts",
    "test:packages": "node --test tests/e2e/packages.test.ts"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@eslint/js": "10.0.1",
    "@supabase/supabase-js": "2.119.0",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.1",
    "eslint": "10.14.0",
    "openapi-types": "12.1.3",
    "openapi-typescript": "7.13.0",
    "playwright": "1.65.0",
    "supabase": "3.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "devEngines": {
    "runtime": {
      "name": "deno",
      "version": "2.9.6",
      "onFail": "download"
    }
  }
}
