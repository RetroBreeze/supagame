{
  "name": "@retrobreeze/supagame-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Provision Supabase Game Services in your own project",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "bin": {
    "supagame": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node ../../scripts/prepare-package.ts cli",
    "dev": "node src/cli.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --root ../.. tests/cli"
  },
  "dependencies": {
    "commander": "15.1.0",
    "smol-toml": "1.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RetroBreeze/supagame.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/RetroBreeze/supagame#readme",
  "bugs": {
    "url": "https://github.com/RetroBreeze/supagame/issues"
  },
  "keywords": [
    "supabase",
    "games",
    "leaderboards",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
