{
  "name": "@supagame/cli",
  "version": "0.1.6",
  "private": true,
  "description": "Provision Supabase Game Services in your own project",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "bin": {
    "supagame": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "node ../../scripts/prepare-package.ts cli",
    "dev": "node src/cli.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --root ../.. tests/cli"
  },
  "dependencies": {
    "commander": "15.1.0",
    "smol-toml": "1.9.1"
  }
}
