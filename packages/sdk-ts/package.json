{
  "name": "@retrobreeze/supagame-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-compatible TypeScript client for the Supagame HTTP API",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "prepack": "node ../../scripts/prepare-package.ts sdk-ts",
    "test": "vitest run --root ../.. tests/sdk",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src scripts --max-warnings=0",
    "validators:generate": "node scripts/generate-validators.ts",
    "validators:check": "node scripts/generate-validators.ts --check"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "dependencies": {
    "@retrobreeze/supagame-contracts": "workspace:*"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.119.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RetroBreeze/supagame.git",
    "directory": "packages/sdk-ts"
  },
  "homepage": "https://github.com/RetroBreeze/supagame#readme",
  "bugs": {
    "url": "https://github.com/RetroBreeze/supagame/issues"
  },
  "keywords": [
    "supabase",
    "games",
    "leaderboards",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  }
}
