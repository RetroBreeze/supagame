{
  "name": "@supagame/contracts",
  "version": "0.1.4",
  "private": true,
  "description": "Versioned HTTP contract and shared game service DTOs",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./openapi.yaml": "./openapi.yaml"
  },
  "files": [
    "dist",
    "openapi.yaml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --root ../.. tests/api/contract.test.ts"
  }
}
